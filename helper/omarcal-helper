# ---------------------------------------------------------------- credentials


def load_password(account: str) -> str:
    override = os.environ.get("OMARCAL_PASSWORD")
    if override:
        return override
    try:
        done = subprocess.run(
            ["secret-tool", "lookup", "schema", KEYRING_SCHEMA, "account", account],
            capture_output=True, text=True, timeout=10,
        )
        if done.returncode == 0 and done.stdout:
            return done.stdout.strip("\n")
    except (OSError, subprocess.SubprocessError):
        pass
    raise Failure("no-password", f"no stored password for {account}")


def forget_password(account: str) -> None:
    try:
        subprocess.run(
            ["secret-tool", "clear", "schema", KEYRING_SCHEMA, "account", account],
            capture_output=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def stored_password(account: str) -> str:
    """The password held for an account, or "" when there is none."""
    try:
        done = subprocess.run(
            ["secret-tool", "lookup", "schema", KEYRING_SCHEMA, "account", account],
            capture_output=True, text=True, timeout=10,
        )
        if done.returncode == 0 and done.stdout:
            return done.stdout.strip("\n")
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def store_password(account: str, password: str) -> None:
    subprocess.run(
        ["secret-tool", "store", "--label", f"omarcal ({account})",
         "schema", KEYRING_SCHEMA, "account", account],
        input=password, text=True, check=True, timeout=10,
    )


class Failure(Exception):
    """An error worth reporting to the UI verbatim."""

    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


# ------------------------------------------------------------------ transport


class DavSession:
    """Pooled HTTPS connections, one per thread per host.

    Reusing the connection is the single biggest win on a cold sync: a large
    calendar is dozens of multiget requests, and a fresh TLS handshake on each
    one dominated the time before this.
    """

    def __init__(self, user: str, password: str):
        token = base64.b64encode(f"{user}:{password}".encode()).decode("ascii")
        self.headers = {
            "Authorization": f"Basic {token}",
            "User-Agent": "omarcal/0.1",
            "Content-Type": "application/xml; charset=utf-8",
        }
        self._local = threading.local()
        self._context = ssl.create_default_context()

    def _connection(self, host: str) -> http.client.HTTPSConnection:
        pool = getattr(self._local, "pool", None)
        if pool is None:
            pool = self._local.pool = {}
        conn = pool.get(host)
        if conn is None:
            conn = pool[host] = http.client.HTTPSConnection(
                host, timeout=REQUEST_TIMEOUT, context=self._context
            )
        return conn

    def request(self, method: str, url: str, body: str = "", depth: str = "0") -> tuple[int, bytes]:
        host, path = split_url(url)
        headers = dict(self.headers, Depth=depth)
        payload = body.encode("utf-8") if body else None
        for attempt in (1, 2):
            conn = self._connection(host)
            try:
                conn.request(method, path, body=payload, headers=headers)
                resp = conn.getresponse()
                data = resp.read(MAX_RESPONSE_BYTES)
                return resp.status, data
            except (http.client.HTTPException, OSError):
                # A pooled connection the server already closed fails on first
                # use; drop it and retry once on a fresh one.
                try:
                    conn.close()
                except OSError:
                    pass
                self._local.pool.pop(host, None)
                if attempt == 2:
                    raise
        raise Failure("transport", "unreachable")

    def close(self) -> None:
        for conn in getattr(self._local, "pool", {}).values():
            try:
                conn.close()
            except OSError:
                pass


def split_url(url: str) -> tuple[str, str]:
    rest = url.split("://", 1)[1]
    host, _, path = rest.partition("/")
    return host, "/" + path


def absolute(base: str, href: str) -> str:
    if href.startswith("http"):
        return href
    host, _ = split_url(base)
    return f"https://{host}{href}"


def text_of(node, path: str) -> str:
    found = node.find(path, NS)
    return (found.text or "").strip() if found is not None else ""


# ------------------------------------------------------------------ discovery


def discover(session: DavSession, server: str = ICLOUD) -> dict:
    """current-user-principal -> calendar-home-set -> the calendars."""
    status, body = session.request(
        "PROPFIND", server,
        '<?xml version="1.0"?><d:propfind xmlns:d="DAV:">'
        "<d:prop><d:current-user-principal/></d:prop></d:propfind>",
    )
    # iCloud answers a wrong password with 403 at the principal lookup, not
    # 401, so both mean the same thing to whoever is filling in the form.
    if status in (401, 403):
        raise Failure("auth",
                      "the server rejected that account and password — "
                      "iCloud needs an app-specific password, not your Apple ID password")
    if status not in (200, 207):
        raise Failure("discovery", f"principal lookup returned HTTP {status}")

    principal = text_of(ET.fromstring(body), ".//d:current-user-principal/d:href")
    if not principal:
        raise Failure("discovery", "server returned no principal")
    principal_url = absolute(server, principal)

    _, body = session.request(
        "PROPFIND", principal_url,
        '<?xml version="1.0"?><d:propfind xmlns:d="DAV:" '
        'xmlns:c="urn:ietf:params:xml:ns:caldav">'
        "<d:prop><c:calendar-home-set/></d:prop></d:propfind>",
    )
    home = text_of(ET.fromstring(body), ".//c:calendar-home-set/d:href")
    if not home:
        raise Failure("discovery", "server returned no calendar-home-set")
    home_url = absolute(principal_url, home)

    _, body = session.request(
        "PROPFIND", home_url,
        '<?xml version="1.0"?><d:propfind xmlns:d="DAV:" '
        'xmlns:c="urn:ietf:params:xml:ns:caldav" '
        'xmlns:cs="http://calendarserver.org/ns/" '
        'xmlns:a="http://apple.com/ns/ical/"><d:prop>'
        "<d:resourcetype/><d:displayname/><cs:getctag/><d:current-user-privilege-set/>"
        "<c:supported-calendar-component-set/><a:calendar-color/>"
        "</d:prop></d:propfind>",
        depth="1",
    )

    calendars = []
    for resp in ET.fromstring(body).findall("d:response", NS):
        href = text_of(resp, "d:href")
        kinds = {
            child.tag.split("}")[-1]
            for node in resp.findall(".//d:resourcetype", NS)
            for child in node
        }
        # The home collection and the scheduling inbox/outbox answer here too;
        # only a real <calendar/> holding VEVENTs is ours. VTODO-only
        # collections are Apple Reminders lists, not calendars.
        if "calendar" not in kinds or kinds & {"schedule-inbox", "schedule-outbox"}:
            continue
        comps = [
            c.get("name")
            for c in resp.findall(".//c:supported-calendar-component-set/c:comp", NS)
        ]
        if "VEVENT" not in comps:
            continue
        privileges = {
            child.tag.split("}")[-1]
            for node in resp.findall(".//d:current-user-privilege-set", NS)
            for priv in node
            for child in priv
        }
        calendars.append({
            "href": href,
            "url": absolute(home_url, href),
            "name": text_of(resp, ".//d:displayname") or href.rstrip("/").rsplit("/", 1)[-1],
            "color": (text_of(resp, ".//a:calendar-color") or "")[:7],
            "ctag": text_of(resp, ".//cs:getctag"),
            "readonly": bool(privileges) and "write-content" not in privileges,
        })
    return {"principal": principal_url, "home": home_url, "calendars": calendars}


