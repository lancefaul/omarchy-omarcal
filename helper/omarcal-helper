def system_zone():
    """The machine's zone with its rules, not today's offset.

    `datetime.now().astimezone().tzinfo` is a fixed offset — whatever the
    clocks say today — so every event on the far side of a DST change came
    out an hour off: in September, a November 6:15 PM game read 7:15 PM.
    """
    try:
        target = os.path.realpath("/etc/localtime")
        if "/zoneinfo/" in target:
            return ZoneInfo(target.split("/zoneinfo/", 1)[1])
    except Exception:
        pass
    name = os.environ.get("TZ", "").lstrip(":")
    if name:
        try:
            return ZoneInfo(name)
        except Exception:
            pass
    return datetime.now().astimezone().tzinfo


