    "c": "urn:ietf:params:xml:ns:caldav",
    "cs": "http://calendarserver.org/ns/",
    "a": "http://apple.com/ns/ical/",
}

ICLOUD = "https://caldav.icloud.com/"

REQUEST_TIMEOUT = 45.0
MAX_RESPONSE_BYTES = 64 * 1024 * 1024
MULTIGET_BATCH = 64
# iCloud tolerates a handful of parallel requests per account comfortably.
# Higher than this buys nothing and risks throttling.
SYNC_WORKERS = 4
MAX_EXPAND = 20000

KEYRING_SCHEMA = "org.omarchy.omarcal"

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omarcal"
)
DB_PATH = os.path.join(STATE_DIR, "cache.db")

def system_zone():
    """The machine's zone with its rules, not today's offset.

    `datetime.now().astimezone().tzinfo` is a fixed offset — whatever the
    clocks say today — so every event on the far side of a DST change came
    out an hour off: in September, a November 6:15 PM game read 7:15 PM.
    """
    try:
        target = os.path.realpath("/etc/localtime")
        if "/zoneinfo/" in target:
            return ZoneInfo(target.split("/zoneinfo/", 1)[1])
    except Exception:
        pass
    name = os.environ.get("TZ", "").lstrip(":")
    if name:
        try:
            return ZoneInfo(name)
        except Exception:
            pass
    return datetime.now().astimezone().tzinfo


LOCAL_TZ = system_zone()

